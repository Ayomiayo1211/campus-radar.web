
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  previewFeatures = ["driverAdapters"]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("REPORTER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stories      Story[]
}

model Story {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  excerpt          String
  body             String
  contentType      String
  origin           String
  commercialStatus String   @default("EDITORIAL")
  status           String   @default("DRAFT")
  featured         Boolean  @default(false)
  coverImage       String?
  authorName       String
  authorId         String?
  author           User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tags             StoryTag[]
  images           StoryImage[]

  @@index([status, publishedAt])
  @@index([contentType, status])
}

model StoryTag {
  id      String @id @default(cuid())
  storyId String
  tag     String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, tag])
  @@index([storyId])
}

model StoryImage {
  id           String   @id @default(cuid())
  storyId      String
  mediaId      String?  @unique
  url          String
  altText      String?
  caption      String?
  photographer String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  story        Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, displayOrder])
}

model RadarItem {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  summary          String
  kind             String
  origin           String
  commercialStatus String   @default("EDITORIAL")
  status           String   @default("DRAFT")
  coverImage       String?
  eventDate        DateTime?
  location         String?
  link             String?
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, publishedAt])
}

model Opportunity {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  organisation     String
  type             String
  description      String
  deadline         DateTime?
  applicationUrl   String?
  origin           String
  commercialStatus String   @default("EDITORIAL")
  status           String   @default("DRAFT")
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, deadline])
}

model Submission {
  id         String   @id @default(cuid())
  type       String
  name       String?
  contact    String?
  title      String?
  body       String
  source     String   @default("WEBSITE")
  status     String   @default("PENDING")
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
}

model AdCampaign {
  id          String   @id @default(cuid())
  advertiser  String
  type        String
  placement   String
  creativeUrl String?
  targetUrl   String?
  startsAt    DateTime
  endsAt      DateTime
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, startsAt, endsAt])
}

model Media {
  id           String   @id @default(cuid())
  publicId     String   @unique
  url          String
  secureUrl    String
  resourceType String   @default("image")
  format       String?
  width        Int?
  height       Int?
  bytes        Int?
  originalName String?
  altText      String?
  folder       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
